# ===== 应用 =====
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===== 模型（OpenAI 兼容接口）=====
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ===== 数据库 =====
# Docker Compose 内：postgresql+asyncpg://postgres:postgres@postgres:5432/agent_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# ===== 缓存 =====
# Docker Compose 内：redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ===== 向量库 =====
# 本地 Lite 模式填文件路径；服务端模式填 http://host:19530
MILVUS_URI=./milvus/agent_knowledge.db
MILVUS_COLLECTION_NAME=agent_knowledge

# ===== 向量化与精排 =====
EMBEDDING_MODEL_PATH=./models/bge-m3
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIM=1024
RERANK_MODEL_PATH=./models/bge-reranker-v2-m3
RERANK_DEVICE=cuda:1

# ===== RAG =====
RAG_ENABLED=true
RAG_TOP_K_DENSE=20
RAG_TOP_K_SPARSE=20
RAG_TOP_K_FINAL=5
RAG_RERANK_CANDIDATES=20
# 拒答阈值：低于该重排分判定证据不足（合成语料校准值，换真实文档需重标）
RAG_MIN_RERANK_SCORE=0.1
RAG_CONTEXT_MAX_CHARS=6000

# ===== 分层记忆 =====
MEMORY_TTL_SECONDS=1800
MEMORY_SUMMARY_TTL_SECONDS=7200
MEMORY_MAX_MESSAGES=20
MEMORY_SUMMARY_TRIGGER=12
MEMORY_SUMMARY_KEEP=6
